; No-Art-FPS — Godot 4.7.2
config_version=5

[application]
config/name="No-Art-FPS"
config/version="0.3.0"
run/main_scene="res://scenes/main.tscn"
run/main_scene.moonbase="res://scenes/moonbase.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Sixty seconds. Make every shot count."

[audio]
; Sample playback can throw InvalidStateError on voice reuse in browsers.
general/default_playback_type.web=0

[display]
window/size/viewport_width=1440
window/size/viewport_height=810
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; Rain market uses one environment probe; avoid allocating the default 64-probe atlas.
reflections/reflection_atlas/reflection_size=128
reflections/reflection_atlas/reflection_count=2
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.357, 0.498, 0.784, 1)

[physics]
common/physics_ticks_per_second=60

[input]
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
sprint={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
jump={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}
fire={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":1)]}
aim={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":2)]}
reload={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82)]}
grenade={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":71)]}
pause={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
restart={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194309)]}

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemy body"
3d_physics/layer_4="Enemy head"
3d_physics/layer_6="Prop shot targets"
