extends SceneTree
const Mission = preload("res://scripts/modes/defuse_rules.gd")
func _initialize() -> void:
	var r = Mission.new()
	assert(not r.request_defuse("a_site"))
	r.start()
	assert(not r.request_defuse("missing"))
	assert(r.request_defuse("ct_court"))
	assert(not r.request_defuse("ct_court"))
	r.settle()
	assert(r.completed.size()==1 and r.active)
	r.request_defuse("short")
	r.cancel_defuse("short")
	r.settle()
	assert(r.completed.size()==1)
	r.request_defuse("short")
	r.request_defuse("a_site")
	r.settle()
	assert(r.outcome=="SUCCESS" and not r.active)
	r.start()
	r.request_defuse("a_site")
	r.request_defuse("short")
	r.request_defuse("ct_court")
	r.report_death()
	r.tick(180)
	r.settle()
	assert(r.outcome=="DEAD" and r.completed.is_empty())
	r.start()
	for i in range(10800):r.tick(1.0/60.0)
	assert(r.remaining()==0 and not r.request_defuse("short"))
	r.settle()
	assert(r.outcome=="TIMEOUT")
	assert(not r.request_defuse("a_site"))
	r.start()
	assert(r.completed.is_empty() and r.outcome.is_empty())
	print("DEFUSE_RULES_PASS: unique IDs, cancellation, success, death priority, exact deadline, restart")
	quit()
